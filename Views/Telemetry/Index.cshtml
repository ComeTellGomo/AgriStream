@model List<AgriStream.Models.TelemetryReading>

@{
    ViewData["Title"] = "Farm Telemetry";
}

<div class="container mt-4">

    <h2>Farm Telemetry Dashboard</h2>

    <p>
        View the latest sensor readings, irrigation events,
        and environmental monitoring data.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No telemetry records available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Device ID</th>
                        <th>Sensor Reading</th>
                        <th>Irrigation Event</th>
                        <th>Environment</th>
                        <th>Recorded At (UTC)</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reading in Model)
                    {
                        <tr>
                            <td>@reading.DeviceId</td>
                            <td>@reading.SensorReadings</td>
                            <td>@reading.IrrigationEvents</td>
                            <td>@reading.EnvironmentMonitoring</td>
                            <td>
                                @reading.RecordedAt
                                .UtcDateTime
                                .ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Telemetry"
       asp-action="Index"
       class="btn btn-primary">
        Refresh Readings
    </a>

</div>
