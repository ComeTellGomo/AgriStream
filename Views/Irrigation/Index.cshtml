@model List<AgriStream.Models.DeviceRegistry>

@{
    ViewData["Title"] = "Irrigation Management";
}

<div class="container mt-4">

    <h2>Irrigation Management</h2>

    <p>
        Monitor irrigation controllers and send
        irrigation commands through Azure Queue Storage.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No irrigation controllers registered.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Device ID</th>
                        <th>Device Name</th>
                        <th>Status</th>
                        <th>Last Updated (UTC)</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var device in Model)
                    {
                        bool isActive =
                        device.OperationalStatus == "Active";

                        <tr>
                            <td>@device.DeviceId</td>
                            <td>@device.DeviceName</td>

                            <td>
                                @if (isActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @device.OperationalStatus
                                    </span>
                                }
                            </td>

                            <td>
                                @device.LastUpdated.ToString(
                                "yyyy-MM-dd HH:mm:ss")
                    </td>

                    <td>
                        @if (isActive)
                                {
                                    <button class="btn btn-secondary btn-sm"
                                            disabled>
                                        Already Active
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="Irrigation"
                                          asp-action="Trigger"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="deviceId"
                                               value="@device.DeviceId" />

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Trigger Irrigation
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Irrigation"
       asp-action="Index"
       class="btn btn-outline-primary mt-3">
        Refresh Status
    </a>

</div>